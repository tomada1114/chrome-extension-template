{
  "name": "my-extension",
  "version": "0.1.0",
  "description": "A short description.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.19.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs .output coverage .eslintcache tsconfig.tsbuildinfo test-results playwright-report",
    "clean:deep": "node scripts/clean.mjs .output .wxt coverage .eslintcache tsconfig.tsbuildinfo test-results playwright-report node_modules",
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project=unit --project=component --project=automation",
    "test:watch": "vitest --project=unit --project=component --project=automation",
    "test:coverage": "vitest run --coverage --project=unit --project=component --project=automation",
    "test:manifest": "vitest run --project=manifest",
    "test:related": "vitest related --run --project=unit --project=component --project=automation",
    "test:e2e": "playwright test",
    "e2e:browsers": "playwright install --with-deps chromium",
    "test:skills": "python3 -B -m unittest discover -s .agents/skills/shipping-issues/scripts/tests -t .agents/skills/shipping-issues/scripts/tests -p 'test_*.py'",
    "agents:sync": "node scripts/sync-agents.mjs",
    "agents:check": "node scripts/sync-agents.mjs --check",
    "repo:labels": "node scripts/sync-labels.mjs",
    "repo:ruleset": "node scripts/apply-ruleset.mjs",
    "check:staged": "node scripts/check-staged.mjs",
    "check:quick": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "check:source": "pnpm run hooks:verify && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run build:edge && pnpm run test:manifest && pnpm run test:e2e && pnpm run test:coverage && pnpm run test:skills",
    "fix": "eslint . --fix && prettier --write .",
    "postinstall": "wxt prepare",
    "prepare": "node scripts/verify-hooks.mjs",
    "hooks:install": "lefthook install",
    "hooks:verify": "node scripts/verify-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.6",
    "@types/node": "~24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.28",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@webext-core/messaging": "^4.0.0",
    "@wxt-dev/browser": "^0.3.6",
    "@wxt-dev/i18n": "^0.2.8",
    "@wxt-dev/storage": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
