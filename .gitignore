# Dependencies
node_modules/

# Build output
dist/

# Test and coverage output
coverage/

# Tool caches
.eslintcache
*.tsbuildinfo

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code: personal overrides stay local, shared config is tracked
.claude/settings.local.json
# Claude Code: agent worktrees are full checkouts, never part of this one
.claude/worktrees/
# Codex CLI: personal project rules stay local; the rest of .codex/ is shared config
/.codex/rules/local.rules

# Environment variables, dotenv and direnv alike (example files are tracked on
# purpose). direnv keeps its real values in .envrc.local / .envrc.private, so
# the .envrc.* variants are ignored too, not just the bare name.
#
# The bare .envrc is ignored as a default, not as a prohibition: a project that
# follows direnv's convention of tracking the shared script deletes the .envrc
# line below and keeps the .envrc.* one. The pre-commit guard permits that --
# see checkCommit in scripts/lib/guard/paths.mjs -- so the two layers agree.
.env
.env.*
.envrc
.envrc.*
!.env.example
!.env.sample
!.env.template
!.envrc.example

# Credentials kept in a checkout: never tracked, and never read by a tool here
secrets/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# WXT: generated types (`wxt prepare`) and build/zip output (`wxt build`, `wxt zip`)
.wxt/
.output/

# Playwright reports and traces
test-results/
playwright-report/
